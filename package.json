{
  "name": "secondhand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/server.js\" \"vite --configLoader native --host 127.0.0.1\"",
    "build": "vite build --configLoader native",
    "start": "node server/server.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "admin:create": "node server/scripts/admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:import-pglite": "node server/scripts/import-pglite.js",
    "db:backup": "node server/scripts/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.7"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.27.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
